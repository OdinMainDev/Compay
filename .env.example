# Debug Mode
APP_DEBUG=false
# Порт программы
APP_PORT=8080
# Секретный ключ ( jwt )
APP_SECRET=supersecretkey

# Настройки кеширования
# Количество шардов
CACHE_SHARDS=16 
# Буфер очереди кеширования
CACHE_QUEUE_SIZE=1024
# Таймаут кеш операции (в секундах)
CACHE_OPERATION_TIMEOUT_SECONDS=30

# Настройки БД
DB_HOST=127.0.0.1
DB_NAME=dbname
DB_USER=dbuser
DB_PASSWORD=NULL
DB_PORT=5432

# Настройки redis
REDIS_HOST=localhost:6379
REDIS_USERNAME=""
REDIS_PASSWORD=""

# Уведомления в телеграмм
NOTIFY_TELEGRAM_TOKEN=your-telegram-bot-token
NOTIFY_TELEGRAM_CHAT_ID=-1000000000000

# BTC NODE
BTC_RPC_HOST=bitcoin-testnet.core.chainstack.com:443/your-api-key
BTC_RPC_USERNAME=your-username
BTC_RPC_PASSWORD=your-password